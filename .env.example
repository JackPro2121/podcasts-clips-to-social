# ===================================================================
# ZERO-COST AI PODCAST CLIPPER & SOCIAL PUBLISHER - CONFIGURATION
# ===================================================================

# 1. Google Gemini AI (Free Tier: 15 RPM / 1M tokens/min)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Buffer GraphQL API (Free Tier allows scheduling across connected social accounts)
# Get access token from https://publish.buffer.com or https://developers.buffer.com
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here

# (Optional) Comma-separated list of target Buffer Channel IDs (e.g. 64a1b...,64a1c...)
# Leave empty to automatically broadcast to all connected channels!
BUFFER_CHANNEL_IDS=

# 3. GitHub Token for hosting clips on GitHub Releases (Permanent $0 Direct MP4 Hosting)
# Automatically provided in GitHub Actions as ${{ secrets.GITHUB_TOKEN }}
# For local testing, optional: generate a Personal Access Token with repo scope at https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_REPOSITORY=
